@{
    ViewData["Title"] = "OCR Translator";
}

@section Styles {
    <link rel="stylesheet" href="~/css/ocr.css" />
}

<div class="ocr-page">
    <div class="ocr-container">
        <div class="ocr-header">
            <div class="ocr-icon">
                <span>📷</span>
            </div>
            <div>
                <h1>OCR Translator</h1>
                <p>Extract text from images and translate it instantly</p>
            </div>
        </div>

        <div class="ocr-card">
            <div class="language-selection">
                <div class="language-group">
                    <label>From Language</label>
                    <select id="fromLanguage" class="language-select">
                        <option value="auto">Auto detect</option>
                        <option value="en">English</option>
                        <option value="ru">Russian</option>
                        <option value="uk">Ukrainian</option>
                        <option value="bg">Bulgarian</option>
                        <option value="de">German</option>
                        <option value="fr">French</option>
                        <option value="es">Spanish</option>
                    </select>
                </div>

                <div class="language-group">
                    <label>Translate to</label>
                    <div class="language-checkboxes">
                        <label><input type="checkbox" name="toLanguages" value="en" checked> English</label>
                        <label><input type="checkbox" name="toLanguages" value="ru"> Russian</label>
                        <label><input type="checkbox" name="toLanguages" value="uk"> Ukrainian</label>
                        <label><input type="checkbox" name="toLanguages" value="bg"> Bulgarian</label>
                        <label><input type="checkbox" name="toLanguages" value="de"> German</label>
                        <label><input type="checkbox" name="toLanguages" value="fr"> French</label>
                        <label><input type="checkbox" name="toLanguages" value="es"> Spanish</label>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>Upload Image</label>
                <div class="drop-zone" id="dropZone">
                    <div class="drop-zone-content">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <rect x="3" y="3" width="18" height="18" rx="2" />
                            <circle cx="8.5" cy="8.5" r="1.5" />
                            <path d="M21 15l-5-5L5 21" />
                        </svg>
                        <p>Drop your image here</p>
                        <span>or click to browse</span>
                    </div>
                    <input type="file" id="fileInput" accept="image/*" style="display:none;">
                </div>
                <div class="file-name" id="fileName" style="display:none;"></div>
                <div id="uploadStatus" style="display:none;"></div>
            </div>

            <button type="button" class="translate-btn" id="translateBtn" style="display:none;">
                <span>🌐 Translate</span>
            </button>

            <div id="ocrError" style="display:none;"></div>
        </div>

        <div class="ocr-results" id="ocrResults">
            <div class="result-section" id="imagePreviewSection" style="display:none;">
                <h3>📷 Image</h3>
                <div class="image-preview-wrapper">
                    <img id="imagePreview" src="" alt="Preview" style="display:none;">
                </div>
            </div>

            <div class="result-section" id="ocrProgressSection" style="display:none;">
                <h3>🔍 OCR Progress</h3>
                <div class="progress-container">
                    <div class="progress-bar" id="ocrProgressBar" style="width:0%;display:none;"></div>
                    <span id="ocrProgressText" style="display:none;">0%</span>
                </div>
                <div class="ocr-confidence" id="ocrConfidence" style="display:none;">
                    Confidence: <span id="confidenceValue">0</span>%
                </div>
            </div>

            <div class="result-section" id="extractedTextSection" style="display:none;">
                <h3>📝 Extracted Text</h3>
                <div class="extracted-text" id="extractedText"></div>
            </div>

            <div class="result-section" id="translationSection" style="display:none;">
                <h3>🌐 Translation</h3>
                <div class="translation-result" id="translationResult"></div>
            </div>

            <div class="result-section" id="detectedLanguageSection" style="display:none;">
                <div class="detected-language" id="detectedLanguage">
                    <span>🌍</span>
                    <span id="detectedLanguageText">English</span>
                </div>
            </div>
        </div>

        <div class="ocr-footer">
            <div class="connection-status" id="connectionStatus">
                <span class="dot disconnected"></span>
                <span>Disconnected</span>
            </div>
            <span class="session-id" id="sessionId"></span>
        </div>
    </div>
</div>