@{
    ViewData["Title"] = "Translator";
}

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
}

<div class="translator-page">
    <div class="translator-container">
        <header class="translator-header">
            <div class="translator-icon">
                <span>文</span>
            </div>
            <div>
                <h1>Translator</h1>
                <p>Translate your text into multiple languages instantly.</p>
            </div>
        </header>

        <main class="translator-card">
            <section class="language-selection" aria-label="Language selection">
                <div class="language-group">
                    <label for="fromLanguage">From</label>
                    <div class="select-wrapper">
                        <select id="fromLanguage" class="language-select">
                            <option value="auto">Auto detect</option>
                            <option value="en">English</option>
                            <option value="ru">Russian</option>
                            <option value="uk">Ukrainian</option>
                            <option value="bg">Bulgarian</option>
                            <option value="de">German</option>
                            <option value="fr">French</option>
                            <option value="es">Spanish</option>
                        </select>
                    </div>
                </div>

                <div class="language-group">
                    <label for="languageDropdownButton">To</label>
                    <div class="language-dropdown">
                        <button type="button"
                                class="language-dropdown-button"
                                id="languageDropdownButton"
                                aria-haspopup="true"
                                aria-expanded="false">
                            <span id="selectedLanguagesText">Select languages</span>
                            <span class="dropdown-arrow" aria-hidden="true">↓</span>
                        </button>
                        <div class="language-options"
                             id="languageOptions"
                             role="listbox"
                             aria-label="Target languages">
                            <label role="option">
                                <input type="checkbox" value="en" checked>
                                <span>English</span>
                            </label>
                            <label role="option">
                                <input type="checkbox" value="ru">
                                <span>Russian</span>
                            </label>
                            <label role="option">
                                <input type="checkbox" value="uk">
                                <span>Ukrainian</span>
                            </label>
                            <label role="option">
                                <input type="checkbox" value="bg">
                                <span>Bulgarian</span>
                            </label>
                            <label role="option">
                                <input type="checkbox" value="de">
                                <span>German</span>
                            </label>
                            <label role="option">
                                <input type="checkbox" value="fr">
                                <span>French</span>
                            </label>
                            <label role="option">
                                <input type="checkbox" value="es">
                                <span>Spanish</span>
                            </label>
                        </div>
                    </div>
                </div>
            </section>

            <section class="translator-box" aria-label="Translation area">
                <div class="text-box">
                    <div class="text-box-header">
                        <div class="box-title">
                            <span class="status-dot" aria-hidden="true"></span>
                            <span>Original text</span>
                        </div>
                        <span id="sourceCount">0 characters</span>
                    </div>
                    <textarea id="sourceText"
                              placeholder="Start typing or paste your text here..."
                              spellcheck="false"
                              aria-label="Source text"></textarea>
                    <div class="text-box-footer">
                        <span>Translation starts automatically</span>
                        <button type="button" class="clear-button" id="clearButton" aria-label="Clear text">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M3 6h18M8 6V4a1 1 0 011-1h6a1 1 0 011 1v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6" />
                            </svg>
                            Clear
                        </button>
                    </div>
                </div>

                <div class="text-box translation-box">
                    <div class="text-box-header">
                        <div class="box-title">
                            <span class="status-dot translation-dot" aria-hidden="true"></span>
                            <span>Translation</span>
                        </div>
                        <span class="translation-status" id="translationStatus">Ready</span>
                    </div>
                    <textarea id="translatedText"
                              placeholder="Your translation will appear here..."
                              readonly
                              aria-label="Translated text"></textarea>
                    <div class="text-box-footer">
                        <span id="translationInfo">Select a target language</span>
                        <button type="button" class="copy-button" id="copyButton" aria-label="Copy translation">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <rect x="9" y="9" width="13" height="13" rx="2" />
                                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" />
                            </svg>
                            Copy
                        </button>
                    </div>
                </div>
            </section>

            <div class="translation-progress" id="progressContainer" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                <div class="translation-progress-bar" id="progressBar" style="width: 0%;"></div>
            </div>

            <footer class="text-box-footer" style="border-top: none; padding-top: 12px; margin-top: 8px;">
                <span class="translation-info" id="translationInfoFooter">Select a target language</span>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span class="connection-status" id="connectionStatus">
                        <span class="dot disconnected" aria-hidden="true"></span>
                        <span>Disconnected</span>
                    </span>
                    <span class="session-id" id="sessionId"></span>
                </div>
            </footer>
        </main>

        <section class="history-card" aria-label="Translation history">
            <div class="history-header">
                <div class="history-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                    <span>Translation History</span>
                </div>
                <button type="button" class="history-clear-btn" id="clearHistoryBtn">Clear All</button>
            </div>
            <div class="history-list" id="historyList">
                <div class="history-empty">
                    <span>No translations yet</span>
                    <span>Your translations will appear here</span>
                </div>
            </div>
        </section>

        <footer class="translator-footer">
            <span>Powered by Microsoft Translator</span>
            <span class="footer-separator" aria-hidden="true">•</span>
            <span>Automatic translation</span>
        </footer>
    </div>
</div>