@{
    ViewData["Title"] = "Privacy Policy";
}

@section Styles {
    <link rel="stylesheet" href="~/css/privacy.css" />
}

<div class="privacy-page">
    <div class="privacy-container">
        <div class="privacy-header">
            <div class="privacy-icon">
                <span>🔒</span>
            </div>
            <div>
                <h1>Privacy Policy</h1>
                <p>Your privacy matters to us. Learn how we handle your data.</p>
            </div>
        </div>

        <div class="privacy-card">
            <div class="privacy-section">
                <h2>📋 Information We Collect</h2>
                <p>We collect minimal data to provide translation services:</p>
                <ul>
                    <li><strong>Text you translate</strong> – The content you submit for translation is processed securely and not stored permanently.</li>
                    <li><strong>Images you upload</strong> – Images are processed for text extraction and translation, then removed after completion.</li>
                    <li><strong>Language preferences</strong> – Your selected source and target languages are used to customize your translation experience.</li>
                </ul>
            </div>

            <div class="privacy-section">
                <h2>🔐 How We Use Your Data</h2>
                <ul>
                    <li><strong>Translation processing</strong> – Your text and images are sent to translation services (Microsoft Translator API) solely for the purpose of providing translations.</li>
                    <li><strong>Local storage</strong> – Translation history is stored locally in your browser (localStorage) for your convenience.</li>
                    <li><strong>No permanent storage</strong> – We do not store your translations, images, or personal information on our servers.</li>
                </ul>
            </div>

            <div class="privacy-section">
                <h2>🛡️ Data Protection</h2>
                <ul>
                    <li><strong>Secure connection</strong> – All communication between your browser and our servers is encrypted via HTTPS.</li>
                    <li><strong>Third-party services</strong> – We use Microsoft Translator API and Azure Vision API for translation and OCR services. These services process your data according to their privacy policies.</li>
                    <li><strong>No tracking</strong> – We do not use cookies for tracking or analytics purposes.</li>
                </ul>
            </div>

            <div class="privacy-section">
                <h2>🗑️ Your Data Rights</h2>
                <ul>
                    <li><strong>Access</strong> – You can view your translation history in the app.</li>
                    <li><strong>Delete</strong> – You can clear your translation history at any time using the "Clear All" button in the history section.</li>
                    <li><strong>No data retention</strong> – Your data is not retained on our servers beyond the processing of your translation request.</li>
                </ul>
            </div>

            <div class="privacy-section">
                <h2>📧 Contact</h2>
                <p>If you have any questions about this privacy policy, please contact us at:</p>
                <p><strong>Email:</strong> libertadintegra@@gmail.com</p>
            </div>

            <div class="privacy-section">
                <h2>📅 Updates</h2>
                <p>This privacy policy is effective as of <strong>September 2026</strong>. We may update it from time to time. Please check back regularly for any changes.</p>
            </div>

            <div class="privacy-footer">
                <span>Last updated: September 2026</span>
                <span class="privacy-divider">•</span>
                <span>Version 1.0</span>
            </div>
        </div>
    </div>
</div>